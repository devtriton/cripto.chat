# ============================================================
# VARIÁVEIS DE AMBIENTE - cripto.chat
# Copie para .env e preencha com seus valores reais
# NÃO COMMITAR .env COM SENHAS REAIS!
# ============================================================

# ============================================================
# APLICAÇÃO
# ============================================================
NODE_ENV=production
PORT=3000
RENDER_EXTERNAL_HOSTNAME=seu-app.onrender.com

# ============================================================
# EMAIL (SMTP) - OPCIONAL
# Configure apenas se quiser envio real de OTP por email
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu@email.com
SMTP_PASS=sua_senha_de_app_16_caracteres
SMTP_FROM="cripto.chat <noreply@seudominio.com>"

# ============================================================
# RENDER / DEPLOY
# ============================================================
NODE_ENV=production
PORT=3000
RENDER_EXTERNAL_HOSTNAME=seu-app.onrender.com

# ============================================================
# DEMO MODE (senha: cripto2024)
# ============================================================
